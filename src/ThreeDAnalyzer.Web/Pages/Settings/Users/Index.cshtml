@page "/Settings/Users"
@{
    ViewData["Title"] = "User Management";
    ViewData["Module"] = "settings-users";
}

<div class="module-page">
    <header class="module-page-header">
        <h1>User Management</h1>
        <p class="module-subtitle">Settings · Users</p>
    </header>
    <div class="module-page-body">
        <div class="table-wrap">
            <table class="data-table" id="users-table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Username</th>
                        <th>Display Name</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <p class="empty-state" id="users-empty" hidden>No users yet.</p>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/settings-users.js"></script>
}
