@page "/ProjectRfq"
@{
    ViewData["Title"] = "Project RFQ";
    ViewData["Module"] = "project-rfq";
}

<div class="module-page" id="project-rfq-page">
    <header class="module-page-header">
        <h1>Project RFQ</h1>
        <p class="module-subtitle" id="rfq-subtitle">Loading…</p>
    </header>
    <div class="module-page-body">
        <div class="module-toolbar">
            <a class="btn" id="back-to-projects" href="/Projects">← Project Manager</a>
        </div>
        <div class="module-toolbar module-toolbar-actions">
            <button type="button" id="btn-add-part">Add Part Number</button>
            <button type="button" id="btn-import-excel">Import from Excel</button>
            <input type="file" id="rfq-import-input" accept=".xlsx,.xls" hidden />
        </div>
        <div class="table-wrap">
            <table class="data-table" id="rfq-table">
                <thead>
                    <tr>
                        <th>Aircraft</th>
                        <th>No</th>
                        <th>Part Number</th>
                        <th>Part Description</th>
                        <th>Picture</th>
                        <th>QPA</th>
                        <th>1st launch quantity</th>
                        <th>1st delivery</th>
                        <th>MATERIAL SPEC</th>
                        <th>FINISH SIZE (MM): THICKNESS / DIAMETER</th>
                        <th>FINISH SIZE (MM): WIDTH</th>
                        <th>FINISH SIZE (MM): LENGTH</th>
                        <th>MATERIAL (MM): RULING DIM.</th>
                        <th>MATERIAL (MM): THICKNESS / DIAMETER</th>
                        <th>MATERIAL (MM): WIDTH</th>
                        <th>MATERIAL (MM): LENGTH</th>
                        <th>QTY/BILLET</th>
                        <th>SETUP TIME (HOUR)</th>
                        <th>CYCLE TIME (HOUR): TurnMill</th>
                        <th>CYCLE TIME (HOUR): 3X</th>
                        <th>CYCLE TIME (HOUR): 4X</th>
                        <th>CYCLE TIME (HOUR): 5X</th>
                        <th>CYCLE TIME (HOUR): TOTAL HRS REQUIRE</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <p class="empty-state" id="rfq-empty" hidden>No parts in this project.</p>
    </div>
</div>

<div id="rfq-add-part-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="rfq-add-part-modal-title">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-content modal-content-sm">
        <div class="modal-header">
            <h3 id="rfq-add-part-modal-title">Add Part Number</h3>
            <button type="button" class="modal-close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <div id="rfq-add-part-modal-error" class="modal-error" role="alert"></div>
            <form id="rfq-add-part-form">
                <div class="form-group">
                    <label for="rfq-part-number">Part Number</label>
                    <input type="text" id="rfq-part-number" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="rfq-part-description">Part Description</label>
                    <input type="text" id="rfq-part-description" class="form-control" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/project-rfq.js?v=1.9.0"></script>
}
