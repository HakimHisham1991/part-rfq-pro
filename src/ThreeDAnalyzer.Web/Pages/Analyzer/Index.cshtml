@page "/Analyzer"
@{
    ViewData["Title"] = "3D Analyzer";
    ViewData["Module"] = "analyzer";
}

<div class="analyzer-shell">
    <header id="toolbar">
        <h1 id="analyzer-part-heading" class="analyzer-part-heading">
            <span class="analyzer-part-label">Part Number:</span>
            <span id="analyzer-part-number">Unknown</span>
        </h1>
        <div id="toolbar-row">
            <button id="btn-open" type="button" onclick="document.getElementById('file-input')?.click()">Open STEP / STP</button>
            <button id="btn-close" type="button">Close</button>
            <input id="file-input" type="file" accept=".step,.stp,.STEP,.STP" style="display:none" />
            <span class="sep"></span>
            <button class="tool-btn" type="button" data-tool="distance">Distance</button>
            <button class="tool-btn" type="button" data-tool="angle">Angle</button>
            <button class="tool-btn" type="button" data-tool="radius">Radius</button>
            <button id="btn-reset-measurements" type="button">Reset Measurement</button>
            <span class="sep"></span>
            <button id="btn-toggle-floor" type="button" title="Show or hide the floor grid">Show Floor</button>
            <button id="btn-toggle-perspective" type="button" title="Toggle perspective projection (off = orthographic)">Perspective</button>
            <span class="sep"></span>
            <span id="status-bar">No file loaded</span>
        </div>
    </header>
    <main id="main-area">
        <aside id="measure-panel">
            <h2>Measurements</h2>
            <div id="measurements-list"></div>
        </aside>
        <aside id="feature-side-panels" class="feature-side-panels all-collapsed">
            <section id="hole-panel" class="feature-panel collapsed">
                <div class="feature-panel-header">
                    <h2>Hole Detection</h2>
                    <button id="btn-collapse-hole-panel" type="button" class="panel-collapse-btn" title="Expand panel" aria-expanded="false">Expand</button>
                </div>
                <div class="feature-panel-body">
                    <div id="hole-detection-section" class="hole-detection-section">
                        <div class="prop-group">
                            <div class="prop-label">Detection Method</div>
                            <select id="hole-fit-method" class="hole-select" title="B-Rep uses exact STEP surfaces (no circle fitting). Mesh methods fit circles to triangles.">
                                <option value="brep-aag" selected>B-Rep Feature Recognition (recommended)</option>
                                <option value="ransac-taubin">Mesh — RANSAC + Taubin</option>
                                <option value="taubin">Mesh — Taubin</option>
                                <option value="kasa">Mesh — Kåsa Least Squares</option>
                                <option value="geometric-iterative">Mesh — Geometric Iterative</option>
                            </select>
                            <div id="hole-method-hint" class="surface-selection-status">Exact CAD surfaces — no circle fit needed</div>
                        </div>
                        <div class="prop-group" id="hole-ransac-group">
                            <div class="prop-label">RANSAC Iterations</div>
                            <input id="hole-ransac-iterations" type="number" class="hole-input" value="500" min="50" max="5000" step="50" />
                        </div>
                        <button id="btn-select-all-bodies" type="button" class="info-panel-btn">Select All Bodies</button>
                        <button id="btn-select-surfaces" type="button" class="info-panel-btn">Select Surfaces</button>
                        <button id="btn-clear-selection" type="button" class="info-panel-btn" disabled>Clear Selection</button>
                        <div id="surface-selection-status" class="surface-selection-status">No surfaces selected</div>
                        <button id="btn-run-hole-detection" type="button" class="info-panel-btn" disabled title="Load a STEP file first">Detect Holes</button>
                    </div>
                    <div class="hole-panel-results">
                        <h2>Detected Holes <span id="hole-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-detected-holes" type="button" class="hole-csv-btn" disabled title="Export Detected Holes to CSV">CSV</button>
                        <div id="holes-list"></div>
                        <hr />
                        <h2>Hole Groups <span id="hole-group-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-hole-groups" type="button" class="hole-csv-btn" disabled title="Export Hole Groups to CSV">CSV</button>
                        <div class="hole-group-toggles">
                            <label class="hole-group-toggle">
                                <input id="chk-group-diameter" type="checkbox" checked />
                                <span>Unique Diameter</span>
                            </label>
                            <label class="hole-group-toggle">
                                <input id="chk-group-depth" type="checkbox" />
                                <span>Unique Depth</span>
                            </label>
                        </div>
                        <div id="holes-summary-list"></div>
                        <button id="btn-add-holes-to-cycle" type="button" class="hole-action-btn" disabled>Add as Drilling Operations</button>
                        <button id="btn-clear-holes" type="button" class="hole-action-btn hole-action-btn-secondary">Clear Holes</button>
                    </div>
                </div>
            </section>
            <section id="pocket-panel" class="feature-panel collapsed">
                <div class="feature-panel-header">
                    <h2>Pocket Detection</h2>
                    <button id="btn-collapse-pocket-panel" type="button" class="panel-collapse-btn" title="Expand panel" aria-expanded="false">Expand</button>
                </div>
                <div class="feature-panel-body">
                    <div id="pocket-detection-section" class="hole-detection-section">
                        <div class="surface-selection-status">B-Rep AAG — floor-anchored cavities (rectangular, circular, slot)</div>
                        <button id="btn-run-pocket-detection" type="button" class="info-panel-btn" disabled title="Load a STEP file first">Detect Pockets</button>
                    </div>
                    <div class="hole-panel-results">
                        <h2>Detected Pockets <span id="pocket-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-detected-pockets" type="button" class="hole-csv-btn" disabled title="Export Detected Pockets to CSV">CSV</button>
                        <div id="pockets-list"></div>
                        <button id="btn-clear-pockets" type="button" class="hole-action-btn hole-action-btn-secondary">Clear Pockets</button>
                    </div>
                </div>
            </section>
        </aside>
        <div id="canvas-container">
            @* Mobile: explicit height chain + overlays — zero-height parents blank the WebGL canvas on Chrome/Android *@
            <canvas id="three-canvas"></canvas>
            <div id="viewer-loading" class="viewer-loading" hidden aria-live="polite">
                <div class="viewer-spinner" aria-hidden="true"></div>
                <div id="viewer-loading-text" class="viewer-loading-text">Loading…</div>
            </div>
            <div id="viewer-error" class="viewer-error" hidden role="alert">
                <span id="viewer-error-text"></span>
                <div class="viewer-error-actions">
                    <button type="button" id="viewer-error-retry" class="viewer-error-btn">Retry</button>
                    <button type="button" id="viewer-error-dismiss" class="viewer-error-btn viewer-error-btn-secondary">Dismiss</button>
                </div>
            </div>
            <div id="surface-select-rect" class="surface-select-rect" hidden></div>
            <div id="hole-progress-panel" class="hole-progress-panel" hidden>
                <div class="hole-progress-header">
                    <span id="hole-progress-title" class="hole-progress-title">Progress</span>
                    <div class="hole-progress-actions">
                        <button id="btn-hole-progress-stop" type="button" class="hole-progress-btn hole-progress-btn-stop" hidden title="Stop detection">Stop</button>
                        <button id="btn-hole-progress-hide" type="button" class="hole-progress-btn" title="Hide panel">Hide</button>
                    </div>
                </div>
                <div class="hole-progress-bar-track">
                    <div id="hole-progress-bar" class="hole-progress-bar" style="width:0%"></div>
                </div>
                <div id="hole-progress-percent" class="hole-progress-percent">0%</div>
                <div id="hole-progress-log" class="hole-progress-log"></div>
            </div>
            <button id="btn-hole-progress-show" type="button" class="hole-progress-show-btn" hidden title="Show progress log">Show Progress</button>
            <div id="view-gnomon">
                <canvas id="gnomon-canvas"></canvas>
            </div>
        </div>
        <aside id="info-panel">
            <h2>Properties</h2>
            <div class="prop-group">
                <div class="prop-label">Part Volume</div>
                <div class="prop-value" id="prop-volume">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Bounding Box</div>
                <div class="prop-value" id="prop-bbox">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Raw Stock Volume</div>
                <div class="prop-value" id="prop-stock-volume">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Material Utilization</div>
                <div class="prop-value" id="prop-utilization">—</div>
            </div>
            <hr />
            <h2>Stock Offsets (mm)</h2>
            <div id="stock-offsets">
                <input type="number" data-face="px" value="0" step="any" />
                <input type="number" data-face="nx" value="0" step="any" />
                <input type="number" data-face="py" value="0" step="any" />
                <input type="number" data-face="ny" value="0" step="any" />
                <input type="number" data-face="pz" value="0" step="any" />
                <input type="number" data-face="nz" value="0" step="any" />
                <button id="btn-apply-stock" type="button">Apply Stock</button>
            </div>
            <hr />
            <h2>Custom Coordinate System</h2>
            <div id="coord-status">Click 3 points on model to define</div>
            <button id="btn-pick-coord" type="button" class="info-panel-btn">Pick 3 points: Origin, X+, Y+</button>
            <button id="btn-apply-coord" type="button" class="info-panel-btn">Apply</button>
        </aside>
    </main>
</div>

@section Scripts {
    <script type="module" src="~/js/viewer.js" asp-append-version="true"></script>
    <script>
      // Surface module load failures (missing/corrupt wwwroot after FTP) in the status bar.
      window.addEventListener('error', function (ev) {
        var status = document.getElementById('status-bar');
        if (!status || !ev) return;
        var msg = (ev.message || '') + ' ' + (ev.filename || '');
        if (/viewer\.js|three\.module|occt-import|Failed to fetch|Loading module/i.test(msg)) {
          status.textContent = 'Viewer script failed to load — check wwwroot/js and wwwroot/lib on the server (hard-refresh Ctrl+F5).';
        }
      }, true);
    </script>
}
