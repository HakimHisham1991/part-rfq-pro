@page "/Analyzer"
@{
    ViewData["Title"] = "3D Analyzer";
    ViewData["Module"] = "analyzer";
}

<div class="analyzer-shell">
    <header id="toolbar">
        <h1 id="analyzer-part-heading" class="analyzer-part-heading">
            <span class="analyzer-part-label">Part Number:</span>
            <span id="analyzer-part-number">Unknown</span>
        </h1>
        <div id="toolbar-row">
            <button id="btn-open" type="button" onclick="document.getElementById('file-input')?.click()">Open STEP / STP</button>
            <button id="btn-close" type="button">Close</button>
            <input id="file-input" type="file" accept=".step,.stp,.STEP,.STP" style="display:none" />
            <span class="sep"></span>
            <button class="tool-btn" type="button" data-tool="distance">Distance</button>
            <button class="tool-btn" type="button" data-tool="angle">Angle</button>
            <button class="tool-btn" type="button" data-tool="radius">Radius</button>
            <button id="btn-reset-measurements" type="button">Reset Measurement</button>
            <span class="sep"></span>
            <button id="btn-toggle-floor" type="button" title="Show or hide the floor grid">Show Floor</button>
            <button id="btn-toggle-perspective" type="button" title="Toggle perspective projection (off = orthographic)">Perspective</button>
            <span class="sep"></span>
            <span id="status-bar">No file loaded</span>
        </div>
    </header>
    <main id="main-area">
        <aside id="measure-panel">
            <h2>Measurements</h2>
            <div id="measurements-list"></div>
        </aside>
        <aside id="feature-side-panels" class="feature-side-panels all-collapsed">
            <section id="hole-panel" class="feature-panel collapsed">
                <div class="feature-panel-header">
                    <h2>Hole Detection</h2>
                    <button id="btn-collapse-hole-panel" type="button" class="panel-collapse-btn" title="Expand panel" aria-expanded="false">Expand</button>
                </div>
                <div class="feature-panel-body">
                    <div id="hole-detection-section" class="hole-detection-section">
                        <div class="prop-group">
                            <div class="prop-label">Detection Method</div>
                            <select id="hole-fit-method" class="hole-select" title="B-Rep uses exact STEP surfaces (no circle fitting). Mesh methods fit circles to triangles.">
                                <option value="brep-aag" selected>B-Rep Feature Recognition (recommended)</option>
                                <option value="ransac-taubin">Mesh — RANSAC + Taubin</option>
                                <option value="taubin">Mesh — Taubin</option>
                                <option value="kasa">Mesh — Kåsa Least Squares</option>
                                <option value="geometric-iterative">Mesh — Geometric Iterative</option>
                            </select>
                            <div id="hole-method-hint" class="surface-selection-status">Exact CAD surfaces — no circle fit needed</div>
                        </div>
                        <div class="prop-group" id="hole-ransac-group">
                            <div class="prop-label">RANSAC Iterations</div>
                            <input id="hole-ransac-iterations" type="number" class="hole-input" value="500" min="50" max="5000" step="50" />
                        </div>
                        <button id="btn-select-all-bodies" type="button" class="info-panel-btn">Select All Bodies</button>
                        <button id="btn-select-surfaces" type="button" class="info-panel-btn">Select Surfaces</button>
                        <button id="btn-clear-selection" type="button" class="info-panel-btn" disabled>Clear Selection</button>
                        <div id="surface-selection-status" class="surface-selection-status">No surfaces selected</div>
                        <button id="btn-run-hole-detection" type="button" class="info-panel-btn" disabled title="Load a STEP file first">Detect Holes</button>
                        <button id="btn-plug-holes" type="button" class="info-panel-btn" disabled title="Run Detect Holes first">Plug Holes</button>
                        <button id="btn-clear-hole-plugs" type="button" class="info-panel-btn" disabled title="No hole plugs active">Clear Hole Plugs</button>
                    </div>
                    <div class="hole-panel-results">
                        <h2>Detected Holes <span id="hole-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-detected-holes" type="button" class="hole-csv-btn" disabled title="Export Detected Holes to CSV">CSV</button>
                        <div id="holes-list"></div>
                        <hr />
                        <h2>Hole Groups <span id="hole-group-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-hole-groups" type="button" class="hole-csv-btn" disabled title="Export Hole Groups to CSV">CSV</button>
                        <div class="hole-group-toggles">
                            <label class="hole-group-toggle">
                                <input id="chk-group-diameter" type="checkbox" checked />
                                <span>Unique Diameter</span>
                            </label>
                            <label class="hole-group-toggle">
                                <input id="chk-group-depth" type="checkbox" />
                                <span>Unique Depth</span>
                            </label>
                        </div>
                        <div id="holes-summary-list"></div>
                        <button id="btn-add-holes-to-cycle" type="button" class="hole-action-btn" disabled>Add as Drilling Operations</button>
                        <button id="btn-clear-holes" type="button" class="hole-action-btn hole-action-btn-secondary">Clear Holes</button>
                    </div>
                </div>
            </section>
            <section id="pocket-panel" class="feature-panel collapsed">
                <div class="feature-panel-header">
                    <h2>Pocket Detection</h2>
                    <button id="btn-collapse-pocket-panel" type="button" class="panel-collapse-btn" title="Expand panel" aria-expanded="false">Expand</button>
                </div>
                <div class="feature-panel-body">
                    <div id="pocket-detection-section" class="hole-detection-section">
                        <div id="pocket-gate-warning" class="pocket-method-note" hidden>
                            <span id="pocket-gate-warning-text">
                                Plug Holes must be active first — pocket detection operates on
                                a copy of the part with all holes plugged, to avoid reporting
                                hole bores as false pocket cavities.
                            </span>
                            <button id="btn-goto-hole-detection" type="button" class="info-panel-btn-inline">Plug Holes</button>
                        </div>
                        <div id="pocket-preparing-notice" class="pocket-method-note" hidden>
                            Plugging <span id="pocket-prep-hole-count">0</span> detected hole(s) and preparing the part for pocket detection…
                        </div>
                        <div id="pocket-prep-warning" class="pocket-method-note pocket-method-note-warn" hidden>
                            <span id="pocket-prep-skipped-text"></span>
                        </div>
                        <div class="prop-group">
                            <div class="prop-label">Detection Method</div>
                            <select id="pocket-detection-method" class="hole-select" disabled>
                                <option value="aag-walk">1. AAG Face Walk (recommended)</option>
                                <option value="slicing">2. Slicing-Based (2.5D)</option>
                                <option value="hull-subtract">3. Convex Hull Subtraction</option>
                                <option value="stock-subtraction">4. Subtraction (Delta-Volume) Decomposition</option>
                                <option value="user-hinted">5. User-Hinted (Manual/Assisted)</option>
                                <option value="morphological-closing">6. Morphological Closing (Dilate → Erode)</option>
                                <option value="voxel-flood-fill">7. Voxelize + Flood-Fill (Robust)</option>
                            </select>
                        </div>
                        <div id="pocket-params-aag-walk" class="pocket-method-params">
                            <div class="surface-selection-status">Floor-anchored cavities on the hole-plugged body (Body 2).</div>
                        </div>
                        <div id="pocket-params-hull-subtract" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Convex wrap of Body 2 → shrink 0.2 mm inward → subtract plugged part. Leftover solids are cavity volumes.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Cavity Volume (mm³)</div>
                                <input id="pocket-min-volume" type="number" class="hole-input" value="1" min="0" step="0.5" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Opening Width (mm)</div>
                                <input id="pocket-min-opening" type="number" class="hole-input" value="0.5" min="0.1" step="0.1" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Hull Tessellation Deflection (mm)</div>
                                <input id="pocket-hull-deflection" type="number" class="hole-input" value="0.3" min="0.05" step="0.05" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Hull Shrink (mm)</div>
                                <input id="pocket-hull-shrink" type="number" class="hole-input" value="0.2" min="0.05" step="0.05" title="Inward offset of the convex wrap before subtracting Body 2" />
                            </div>
                        </div>
                        <div id="pocket-params-slicing" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Only finds pockets aligned to the slicing axis. Multi-axis or enclosed voids need Hull Subtraction or AAG Face Walk.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Slicing Axis</div>
                                <select id="pocket-slicing-axis" class="hole-select">
                                    <option value="auto">Auto (largest flat face normal)</option>
                                    <option value="x">X</option>
                                    <option value="y">Y</option>
                                    <option value="z">Z</option>
                                </select>
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Slice Step (mm)</div>
                                <input id="pocket-slice-step" type="number" class="hole-input" value="0.5" min="0.05" step="0.05" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Contour Area (mm²)</div>
                                <input id="pocket-min-contour-area" type="number" class="hole-input" value="1" min="0" step="0.5" />
                            </div>
                        </div>
                        <div id="pocket-params-stock-subtraction" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Subtracts Body 2 from a stock block equal to Body 2's bounding
                                box shrunk inward by 0.2&nbsp;mm per face (same idea as hull
                                shrink) so the boolean leaves only real cavity volume — not
                                zero-thickness exterior shells. Open regions touching the inset
                                stock face are tool-accessible pockets (reported first).
                                Fully enclosed voids are still listed but deprioritized — use
                                Morphological Closing or Voxel Flood-Fill for those.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Cavity Volume (mm³)</div>
                                <input id="pocket-stock-min-volume" type="number" class="hole-input" value="1" min="0" step="0.5" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Opening Width (mm)</div>
                                <input id="pocket-stock-min-opening" type="number" class="hole-input" value="0.5" min="0.1" step="0.1" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Open-Face Touch Tolerance (mm)</div>
                                <input id="pocket-stock-touch-tol" type="number" class="hole-input" value="0.05" min="0.001" step="0.01" title="How close a region must be to a stock envelope face to count as open/accessible" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Open Classification</div>
                                <select id="pocket-stock-classify-by" class="hole-select">
                                    <option value="bbox">Bounding Box (fast)</option>
                                    <option value="exactFace">Exact Face Coincidence (stricter)</option>
                                </select>
                            </div>
                        </div>
                        <div id="pocket-params-morphological-closing" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Grows Body 2 outward, then shrinks it back by the same amount. Fills
                                any gap narrower than 2× the offset while leaving wider outer
                                concavities untouched. Offset must exceed half the widest cavity
                                opening to seal it, and stay under half the thinnest wall to avoid
                                bridging features together.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Closing Offset (mm)</div>
                                <input id="pocket-morph-offset" type="number" class="hole-input" value="1.0" min="0.05" step="0.05" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Cavity Volume (mm³)</div>
                                <input id="pocket-morph-min-volume" type="number" class="hole-input" value="1" min="0" step="0.5" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Opening Width (mm)</div>
                                <input id="pocket-morph-min-opening" type="number" class="hole-input" value="0.5" min="0.1" step="0.1" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Offset Step-Down Retries</div>
                                <input id="pocket-morph-retries" type="number" class="hole-input" value="2" min="0" step="1" title="If the exact B-Rep offset fails at the requested distance, retry at smaller distances this many times before giving up" />
                            </div>
                        </div>
                        <div id="pocket-params-voxel-flood-fill" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Rasterizes Body 2 into a voxel grid, flood-fills from outside the
                                part, and keeps whatever voxels the flood never reaches as enclosed
                                cavities. Most robust option on messy or self-intersecting geometry;
                                results are a blocky (staircase) approximation, not exact B-Rep.
                                Best for fully enclosed internal voids — open pockets may be missed.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Voxel Size (mm)</div>
                                <input id="pocket-voxel-size" type="number" class="hole-input" value="1.0" min="0.05" step="0.05" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Padding (mm)</div>
                                <input id="pocket-voxel-padding" type="number" class="hole-input" value="2.0" min="0" step="0.5" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Min Cavity Volume (mm³)</div>
                                <input id="pocket-voxel-min-volume" type="number" class="hole-input" value="1" min="0" step="0.5" />
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Classification Method</div>
                                <select id="pocket-voxel-classify-by" class="hole-select">
                                    <option value="meshParity">Mesh Parity (fast)</option>
                                    <option value="containsPoint">Exact B-Rep Point Test (slow, robust)</option>
                                </select>
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Max Voxel Count (safety cap)</div>
                                <input id="pocket-voxel-max-count" type="number" class="hole-input" value="500000" min="1000" step="1000" title="Voxel size is auto-coarsened if the grid would exceed this" />
                            </div>
                        </div>
                        <div id="pocket-params-user-hinted" class="pocket-method-params" hidden>
                            <div class="pocket-method-note">
                                Define one pocket at a time by selecting Body 2 faces in the viewer.
                            </div>
                            <div class="prop-group">
                                <div class="prop-label">Step 1 — Floor</div>
                                <button id="btn-select-floor" type="button" class="info-panel-btn-inline">Select Floor</button>
                                <button id="btn-suggest-floor" type="button" class="info-panel-btn-inline">Suggest Largest Floor</button>
                                <button id="btn-clear-floor" type="button" class="info-panel-btn-inline info-panel-btn-secondary">Clear</button>
                                <span id="floor-selection-count" class="hint-selection-count">0 face(s) selected</span>
                                <div id="floor-selection-list" class="hint-face-list" role="list" aria-label="Selected floor faces"></div>
                            </div>
                            <div class="prop-group" id="hint-wall-step" data-disabled="true">
                                <div class="prop-label">Step 2 — Walls</div>
                                <button id="btn-select-walls" type="button" class="info-panel-btn-inline">Select Walls</button>
                                <button id="btn-detect-walls" type="button" class="info-panel-btn-inline">Detect Walls</button>
                                <button id="btn-clear-walls" type="button" class="info-panel-btn-inline info-panel-btn-secondary">Clear Walls</button>
                                <span id="wall-selection-count" class="hint-selection-count">0 face(s)</span>
                                <div id="wall-selection-list" class="hint-face-list" role="list" aria-label="Selected wall faces"></div>
                                <div id="hint-detect-wall-options" hidden>
                                    <div class="prop-group">
                                        <label><input id="hint-include-fillets" type="checkbox" checked /> Include Fillets</label>
                                    </div>
                                    <div class="prop-group">
                                        <div class="prop-label">Max Traversal Depth</div>
                                        <input id="hint-max-depth" type="number" class="hole-input" value="200" min="1" step="1" />
                                    </div>
                                </div>
                            </div>
                            <div class="prop-group" id="hint-plug-step" data-disabled="true">
                                <div class="prop-label">Step 3 — Axis</div>
                                <select id="hint-axis-mode" class="hole-select">
                                    <option value="auto">Auto-suggest (from floor/walls)</option>
                                    <option value="manual">Manual XYZ</option>
                                </select>
                                <div id="hint-axis-manual" hidden>
                                    <input id="hint-axis-x" type="number" class="hole-input hint-axis-input" value="0" step="0.1" placeholder="X" />
                                    <input id="hint-axis-y" type="number" class="hole-input hint-axis-input" value="0" step="0.1" placeholder="Y" />
                                    <input id="hint-axis-z" type="number" class="hole-input hint-axis-input" value="1" step="0.1" placeholder="Z" />
                                </div>
                                <span id="hint-axis-preview" class="hint-selection-count"></span>
                            </div>
                            <div class="prop-group" id="hint-calculate-step" data-disabled="true">
                                <button id="btn-hint-calculate" type="button" class="info-panel-btn">Calculate → Add to Table</button>
                                <button id="btn-hint-new-pocket" type="button" class="info-panel-btn-secondary" hidden>Define Another Pocket</button>
                            </div>
                        </div>
                        <button id="btn-run-pocket-detection" type="button" class="info-panel-btn" disabled title="Run hole detection first">Detect Pockets</button>
                    </div>
                    <div class="hole-panel-results">
                        <h2>Detected Pockets <span id="pocket-count-badge" class="hole-count-badge">0</span></h2>
                        <button id="btn-csv-detected-pockets" type="button" class="hole-csv-btn" disabled title="Export Detected Pockets to CSV">CSV</button>
                        <div id="pockets-list"></div>
                        <button id="btn-clear-pockets" type="button" class="hole-action-btn hole-action-btn-secondary">Clear Pockets</button>
                    </div>
                </div>
            </section>
        </aside>
        <div id="canvas-container">
            @* Mobile: explicit height chain + overlays — zero-height parents blank the WebGL canvas on Chrome/Android *@
            <canvas id="three-canvas"></canvas>
            <div id="viewer-loading" class="viewer-loading" hidden aria-live="polite">
                <div class="viewer-spinner" aria-hidden="true"></div>
                <div id="viewer-loading-text" class="viewer-loading-text">Loading…</div>
            </div>
            <div id="viewer-error" class="viewer-error" hidden role="alert">
                <span id="viewer-error-text"></span>
                <div class="viewer-error-actions">
                    <button type="button" id="viewer-error-retry" class="viewer-error-btn">Retry</button>
                    <button type="button" id="viewer-error-dismiss" class="viewer-error-btn viewer-error-btn-secondary">Dismiss</button>
                </div>
            </div>
            <div id="surface-select-rect" class="surface-select-rect" hidden></div>
            <div id="hole-progress-panel" class="hole-progress-panel" hidden>
                <div class="hole-progress-header">
                    <span id="hole-progress-title" class="hole-progress-title">Progress</span>
                    <div class="hole-progress-actions">
                        <button id="btn-hole-progress-stop" type="button" class="hole-progress-btn hole-progress-btn-stop" hidden title="Stop detection">Stop</button>
                        <button id="btn-hole-progress-hide" type="button" class="hole-progress-btn" title="Hide panel">Hide</button>
                    </div>
                </div>
                <div class="hole-progress-bar-track">
                    <div id="hole-progress-bar" class="hole-progress-bar" style="width:0%"></div>
                </div>
                <div id="hole-progress-percent" class="hole-progress-percent">0%</div>
                <div id="hole-progress-log" class="hole-progress-log"></div>
            </div>
            <button id="btn-hole-progress-show" type="button" class="hole-progress-show-btn" hidden title="Show progress log">Show Progress</button>
            <div id="view-gnomon">
                <canvas id="gnomon-canvas"></canvas>
            </div>
        </div>
        <aside id="info-panel">
            <h2>Properties</h2>
            <div class="prop-group">
                <div class="prop-label">Part Volume</div>
                <div class="prop-value" id="prop-volume">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Bounding Box</div>
                <div class="prop-value" id="prop-bbox">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Raw Stock Volume</div>
                <div class="prop-value" id="prop-stock-volume">—</div>
            </div>
            <div class="prop-group">
                <div class="prop-label">Material Utilization</div>
                <div class="prop-value" id="prop-utilization">—</div>
            </div>
            <hr />
            <h2>Stock Offsets (mm)</h2>
            <div id="stock-offsets">
                <input type="number" data-face="px" value="0" step="any" />
                <input type="number" data-face="nx" value="0" step="any" />
                <input type="number" data-face="py" value="0" step="any" />
                <input type="number" data-face="ny" value="0" step="any" />
                <input type="number" data-face="pz" value="0" step="any" />
                <input type="number" data-face="nz" value="0" step="any" />
                <button id="btn-apply-stock" type="button">Apply Stock</button>
            </div>
            <hr />
            <h2>Custom Coordinate System</h2>
            <div id="coord-status">Click 3 points on model to define</div>
            <button id="btn-pick-coord" type="button" class="info-panel-btn">Pick 3 points: Origin, X+, Y+</button>
            <button id="btn-apply-coord" type="button" class="info-panel-btn">Apply</button>
        </aside>
    </main>
</div>

@section Scripts {
    <script type="module" src="~/js/viewer.js" asp-append-version="true"></script>
    <script>
      // Surface module load failures (missing/corrupt wwwroot after FTP) in the status bar.
      window.addEventListener('error', function (ev) {
        var status = document.getElementById('status-bar');
        if (!status || !ev) return;
        var msg = (ev.message || '') + ' ' + (ev.filename || '');
        if (/viewer\.js|three\.module|occt-import|Failed to fetch|Loading module/i.test(msg)) {
          status.textContent = 'Viewer script failed to load — check wwwroot/js and wwwroot/lib on the server (hard-refresh Ctrl+F5).';
        }
      }, true);
    </script>
}
