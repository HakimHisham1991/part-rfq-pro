@page "/CycleTime/Edit"
@{
    ViewData["Title"] = "Edit Cycle Time";
    ViewData["Module"] = "cycle-time";
}

<div class="module-page">
    <header class="module-page-header">
        <h1>Edit Cycle Time</h1>
        <p class="module-subtitle" id="cycle-subtitle">Loading…</p>
    </header>
    <div class="module-page-body">
        <div class="module-toolbar cycle-toolbar">
            <a class="btn" id="back-to-rfq" href="/Projects">← Project RFQ</a>
            <div class="cycle-toolbar-actions">
                <div class="cycle-add-group" id="cycle-quick-add" hidden>
                    <button type="button" class="btn btn-secondary" id="btn-add-operation">+ Add Operation</button>
                    <button type="button" class="btn btn-secondary" data-quick-add="Drilling">+ Add Drill</button>
                    <button type="button" class="btn btn-secondary" data-quick-add="Ballnose Finishing">+ Add Ballnose</button>
                    <button type="button" class="btn btn-secondary" data-quick-add="Face Milling">+ Add Face Mill</button>
                    <button type="button" class="btn btn-secondary" data-quick-add="Roughing">+ Add Roughing</button>
                </div>
                <button type="button" id="btn-save-cycle">Save</button>
            </div>
        </div>

        <p class="empty-state" id="cycle-empty" hidden>
            No part selected. Open Project RFQ and click a part number or Edit.
        </p>

        <div id="cycle-editor-wrap" hidden>
            <div class="cycle-summary-row">
                <div class="cycle-summary">
                    <label>Part Number:</label>
                    <span class="summary-value" id="cycle-part-number">—</span>
                    <span></span>
                    <span></span>
                    <label>Cycle Time to Quote:</label>
                    <span class="summary-value" id="cycle-quote-hr">—</span>
                    <span>hr</span>
                    <span class="col-formula">=ROUNDUP((Total Overall CT),0.1)</span>
                </div>
                <div class="cycle-3d-model-panel">
                    <h2 class="cycle-3d-model-title">3D Model</h2>
                    <table class="cycle-table cycle-3d-model-table" id="cycle-3d-model-table">
                        <thead>
                            <tr>
                                <th>CAD Model</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="cycle-3d-model-tbody">
                            <tr>
                                <td id="cycle-3d-model-name">—</td>
                                <td class="cycle-3d-model-actions">
                                    <button type="button" class="btn btn-secondary btn-xs" id="btn-3d-model-add">ADD</button>
                                    <button type="button" class="btn btn-secondary btn-xs" id="btn-3d-model-delete" disabled>DELETE</button>
                                    <button type="button" class="btn btn-secondary btn-xs" id="btn-3d-model-edit" disabled>EDIT</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <input type="file" id="cycle-3d-model-input" accept=".step,.stp" hidden />
                </div>
            </div>

            <div class="cycle-material-grid" id="cycle-material-size">
                <div class="cycle-material-panel">
                    <div class="cycle-material-panel-header">
                        <h2 class="cycle-material-title">Raw Material</h2>
                        <div class="cycle-material-panel-actions">
                            <button type="button" class="btn btn-secondary btn-xs" id="btn-retrieve-raw-rfq">RETRIEVE FROM RFQ</button>
                            <button type="button" class="btn btn-secondary btn-xs" id="btn-retrieve-raw-3d">RETRIEVE FROM 3D</button>
                        </div>
                    </div>
                    <table class="cycle-table cycle-material-table" id="cycle-raw-material-table">
                        <thead>
                            <tr>
                                <th>Properties</th>
                                <th>Data</th>
                                <th>Unit</th>
                            </tr>
                        </thead>
                        <tbody id="cycle-raw-material-tbody"></tbody>
                    </table>
                </div>
                <div class="cycle-material-panel">
                    <div class="cycle-material-panel-header">
                        <h2 class="cycle-material-title">Finish Part</h2>
                        <button type="button" class="btn btn-secondary btn-xs" id="btn-retrieve-finish-3d">RETRIEVE FROM 3D</button>
                    </div>
                    <table class="cycle-table cycle-material-table" id="cycle-finish-part-table">
                        <thead>
                            <tr>
                                <th>Properties</th>
                                <th>Data</th>
                                <th>Unit</th>
                            </tr>
                        </thead>
                        <tbody id="cycle-finish-part-tbody"></tbody>
                    </table>
                </div>
            </div>

            <div class="cycle-table-wrap">
                <table class="cycle-table cycle-ops-table" id="cycle-operations-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Operation Name</th>
                            <th>Operation Type</th>
                            <th>Ø</th>
                            <th>ap</th>
                            <th>ae</th>
                            <th>F</th>
                            <th>MRR</th>
                            <th>V</th>
                            <th>Area to scan</th>
                            <th>Profile Length</th>
                            <th>No. of Holes</th>
                            <th>CT</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cycle-operations-tbody"></tbody>
                </table>
                <p class="empty-state" id="cycle-operations-empty" hidden>
                    No operations yet. Use <strong>+ Add Operation</strong> or a quick-add button.
                </p>
            </div>

            <section class="cycle-other-panel" id="cycle-other-panel">
                <div class="cycle-other-header">
                    <label class="cycle-other-toggle" title="Enable or disable other time factor calculations">
                        <input type="checkbox" id="cycle-other-enabled" checked />
                        <span class="cycle-other-toggle-switch" aria-hidden="true"></span>
                        <span class="sr-only">Enable Other Time Factors</span>
                    </label>
                    <h2 class="cycle-other-title">Other Time Factors</h2>
                </div>
                <div class="cycle-other-grid" id="cycle-other-fields"></div>
            </section>

            <div class="cycle-totals" id="cycle-totals"></div>
        </div>
    </div>
</div>

<div id="cycle-add-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="cycle-add-modal-title">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-content modal-content-sm">
        <div class="modal-header">
            <h3 id="cycle-add-modal-title">Add Operation</h3>
            <button type="button" class="modal-close" data-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="cycle-add-type">Operation Type</label>
                <select id="cycle-add-type" class="form-control"></select>
            </div>
            <div class="form-group">
                <label for="cycle-add-template">From Template (optional)</label>
                <select id="cycle-add-template" class="form-control">
                    <option value="">— Blank defaults —</option>
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
                <button type="button" class="btn btn-primary" id="cycle-add-confirm">Add</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/cycle-time.js?v=1.15.2"></script>
}
