@inject OcctService Occt
@inject ThreeJsInterop ThreeJs
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using System.Threading

<div class="viewer-wrap" style="position:relative;">
    <canvas id="@_canvasId"
            style="width:100%;height:100%;display:block;background:#1c1c2e;border-radius:6px;"
            tabindex="0">
    </canvas>

    @if (_loading)
    {
        <div class="viewer-overlay">
            <div class="spinner-border text-info" role="status"></div>
            <span class="ms-2 text-info">@_loadingMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="viewer-overlay-err alert alert-danger m-3">@_error</div>
    }

    <div class="viewer-hint" style="@(_snapMode ? "display:none" : "")">
        Middle-drag rotate &nbsp;|&nbsp; Shift + middle-drag pan &nbsp;|&nbsp; Scroll zoom &nbsp;|&nbsp; <kbd>F</kbd> fit view
    </div>
    @if (_snapMode)
    {
        <div class="viewer-snap-hint">
            @(SnapHint ?? "Snap — click a surface point")
        </div>
    }
</div>

@code {
    private readonly string _canvasId = $"vp_{Guid.NewGuid():N}";
    private DotNetObjectReference<ModelViewer>? _selfRef;
    private bool _loading;
    private string _loadingMessage = "";
    private string? _error;
    private bool _snapMode;
    private int _snapIndex;
    private bool _jsViewerInitialized;
    private readonly SemaphoreSlim _viewerInitLock = new(1, 1);

    [Parameter] public string? SnapHint { get; set; }
    [Parameter] public EventCallback<(int Index, Point3D Hit)> SnapPointPicked { get; set; }
    [Parameter] public EventCallback<RadiusPickResult> RadiusPicked { get; set; }
    [Parameter] public EventCallback<string> ErrorOccurred { get; set; }

    private string _pickMode = "surface";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jsViewerInitialized) return;
        try
        {
            await EnsureViewerGateInitializedAsync();
        }
        catch (JSException ex)
        {
            _error = $"Viewer JavaScript failed: {ex.Message}";
        }
        catch (InvalidOperationException) { }
        catch (Exception ex)
        {
            _error = $"Viewer init failed: {ex.Message}";
        }
    }

    private async Task EnsureViewerGateInitializedAsync()
    {
        if (_jsViewerInitialized) return;
        await _viewerInitLock.WaitAsync();
        try
        {
            if (_jsViewerInitialized) return;
            _selfRef ??= DotNetObjectReference.Create(this);
            await ThreeJs.InitViewerAsync(_canvasId, _selfRef);
            _jsViewerInitialized = true;
        }
        finally
        {
            _viewerInitLock.Release();
        }
    }

    public async Task LoadModelAsync(IBrowserFile file)
    {
        _error = null;
        _loading = true;
        _loadingMessage = "Reading STEP file…";
        StateHasChanged();

        try
        {
            await EnsureViewerGateInitializedAsync();

            if (!await Occt.LoadFileAsync(file))
            {
                _error = "Failed to parse STEP/STP (AP203/AP214).";
                await ErrorOccurred.InvokeAsync(_error);
                return;
            }

            _loadingMessage = "Tessellating…";
            StateHasChanged();

            var mesh = await Occt.GetMeshAsync();
            if (mesh.IsEmpty || mesh.Vertices.Length < 9 || mesh.Indices.Length < 3)
            {
                _error = "No drawable mesh from tessellation.";
                await ErrorOccurred.InvokeAsync(_error);
                return;
            }

            await ThreeJs.LoadMeshAsync(mesh.Vertices, mesh.Indices);

            if (Occt.BoundingBox is { } bb)
                await RefreshStockBoundingBoxAsync(bb, new double[6], null, null);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await ErrorOccurred.InvokeAsync(_error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public async Task RefreshStockBoundingBoxAsync(BoundingBoxData worldBbox, double[] o, CustomCS? customCs, BoundingBoxData? csBbox)
    {
        if (customCs is not null && csBbox is not null && customCs.IsComplete)
            await ShowCustomCsStockBoundingBoxAsync(customCs, csBbox, o);
        else
            await ShowWorldStockBoundingBoxAsync(worldBbox, o);
    }

    private async Task ShowWorldStockBoundingBoxAsync(BoundingBoxData bb, double[] o) =>
        await ThreeJs.UpdateBoundingBoxAsync(
            bb.MinX - o[1], bb.MinY - o[3], bb.MinZ - o[5],
            bb.MaxX + o[0], bb.MaxY + o[2], bb.MaxZ + o[4]);

    private async Task ShowCustomCsStockBoundingBoxAsync(CustomCS cs, BoundingBoxData csBb, double[] o)
    {
        CustomCoordinateAxes.GetOrthonormalDirections(cs, out var ux, out var uy, out var uz);
        var o0 = cs.Origin!;
        await ThreeJs.ShowOrientedBoundingBoxAsync(
            o0.X, o0.Y, o0.Z,
            ux.X, ux.Y, ux.Z,
            uy.X, uy.Y, uy.Z,
            uz.X, uz.Y, uz.Z,
            csBb.MinX - o[1], csBb.MinY - o[3], csBb.MinZ - o[5],
            csBb.MaxX + o[0], csBb.MaxY + o[2], csBb.MaxZ + o[4]);
    }

    public async Task EnterSnapModeAsync(int pointIndex, string pickMode = "surface")
    {
        _snapIndex = pointIndex;
        _pickMode = pickMode == "radius" ? "radius" : "surface";
        _snapMode = true;
        await ThreeJs.SetSnapModeAsync(true, pointIndex, _pickMode);
        StateHasChanged();
    }

    public async Task ExitSnapModeAsync()
    {
        _snapMode = false;
        _pickMode = "surface";
        await ThreeJs.SetSnapModeAsync(false, 0, "surface");
        StateHasChanged();
    }

    public async Task ClearSnapMarkersAsync() =>
        await ThreeJs.ClearSnapMarkersAsync();

    public async Task RefreshPickMarkersAsync(Point3D?[] hits, int sphereVisibleIdx)
    {
        FlattenSnapHits(hits,
            out var h0, out var x0, out var y0, out var z0,
            out var h1, out var x1, out var y1, out var z1,
            out var h2, out var x2, out var y2, out var z2);

        await ThreeJs.SyncCsPickMarkersAsync(
            h0, x0, y0, z0,
            h1, x1, y1, z1,
            h2, x2, y2, z2,
            sphereVisibleIdx);
    }

    private static void FlattenSnapHits(Point3D?[]? hits,
        out bool h0, out double x0, out double y0, out double z0,
        out bool h1, out double x1, out double y1, out double z1,
        out bool h2, out double x2, out double y2, out double z2)
    {
        hits ??= new Point3D?[3];
        h0 = hits.Length > 0 && hits[0] is not null;
        x0 = hits[0]?.X ?? 0; y0 = hits[0]?.Y ?? 0; z0 = hits[0]?.Z ?? 0;
        h1 = hits.Length > 1 && hits[1] is not null;
        x1 = hits[1]?.X ?? 0; y1 = hits[1]?.Y ?? 0; z1 = hits[1]?.Z ?? 0;
        h2 = hits.Length > 2 && hits[2] is not null;
        x2 = hits[2]?.X ?? 0; y2 = hits[2]?.Y ?? 0; z2 = hits[2]?.Z ?? 0;
    }

    [JSInvokable]
    public async Task OnSurfacePick(int pointIndex, double x, double y, double z) =>
        await DispatchPickAsync(pointIndex, new Point3D(x, y, z));

    [JSInvokable]
    public async Task OnRayPick(int pointIndex, double ox, double oy, double oz, double dx, double dy, double dz)
    {
        var ray = new Ray(ox, oy, oz, dx, dy, dz);
        if (Occt.RayPick(ray, out var hit))
            await DispatchPickAsync(pointIndex, hit);
        else
            await DispatchPickErrorAsync("No surface hit — left-click directly on the blue part.");
    }

    [JSInvokable]
    public async Task OnRadiusRayPick(int pointIndex, double ox, double oy, double oz, double dx, double dy, double dz)
    {
        var ray = new Ray(ox, oy, oz, dx, dy, dz);
        if (Occt.RayPickRadius(ray, out var result) && result is not null)
            await DispatchRadiusAsync(result);
        else
            await DispatchPickErrorAsync(
                "No radius found — click a cylindrical face, hole, sphere, torus, or circular edge.");
    }

    private async Task DispatchPickAsync(int pointIndex, Point3D hit)
    {
        await InvokeAsync(async () =>
        {
            _snapIndex = pointIndex;
            if (SnapPointPicked.HasDelegate)
                await SnapPointPicked.InvokeAsync((pointIndex, hit));
        });
    }

    private async Task DispatchRadiusAsync(RadiusPickResult result)
    {
        await InvokeAsync(async () =>
        {
            if (RadiusPicked.HasDelegate)
                await RadiusPicked.InvokeAsync(result);
        });
    }

    private async Task DispatchPickErrorAsync(string message)
    {
        await InvokeAsync(async () =>
        {
            if (ErrorOccurred.HasDelegate)
                await ErrorOccurred.InvokeAsync(message);
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsViewerInitialized)
        {
            try { await ThreeJs.DisposeViewerAsync(); }
            catch { /* circuit teardown */ }
        }
        _selfRef?.Dispose();
        _viewerInitLock.Dispose();
    }
}
