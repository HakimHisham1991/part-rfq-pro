@using ThreeDAnalyzer.Core.Models

<div class="panel-block">
    <div class="panel-title">Measure</div>

    @if (!ModelLoaded)
    {
        <div class="text-muted" style="font-size:12px;">Load a STEP file first.</div>
    }
    else
    {
        <div class="measure-tools mb-2">
            @foreach (var t in _tools)
            {
                <button type="button"
                        class="btn btn-sm @(ActiveTool == t ? "btn-info" : "btn-outline-secondary") me-1 mb-1"
                        @onclick="() => SelectToolAsync(t)">
                    @Label(t)
                </button>
            }
        </div>

        @if (ActiveTool != MeasureTool.None)
        {
            <div class="measure-hint mb-2">
                @if (ActiveTool == MeasureTool.Radius)
                {
                    <span>Click a cylinder, hole, sphere, torus, or circular edge on the model.</span>
                }
                else
                {
                    <span>Surface snap (click model). Vertex/edge snap: planned.</span>
                    @if (_picking)
                    {
                        <span class="text-info"> — picking point @(_points.Count + 1) of @RequiredPoints</span>
                    }
                }
            </div>
            <div class="d-flex gap-1 mb-2">
                @if (ActiveTool != MeasureTool.Radius)
                {
                    <button type="button" class="btn btn-sm btn-primary" @onclick="StartPick">
                        @(_picking ? "Picking…" : "Pick points")
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnClearClick">
                    Clear
                </button>
            </div>
        }

        @for (var i = 0; i < _points.Count; i++)
        {
            <div class="pick-coord">P@(i + 1): @_points[i].ToString()</div>
        }

        @if (!string.IsNullOrEmpty(_pickWarning))
        {
            <div class="text-warning mt-1" style="font-size:11px;">@_pickWarning</div>
        }

        <div class="measure-result mt-2">
            @if (!string.IsNullOrEmpty(_result))
            {
                <div class="measure-result-value">@_result</div>
            }
            else if (_picking)
            {
                <div class="text-info" style="font-size:12px;">
                    @(ActiveTool == MeasureTool.Radius
                        ? "Click a curved face or circular edge in the viewport…"
                        : "Click the model surface in the viewport…")
                </div>
            }
            else if (ActiveTool != MeasureTool.None && ActiveTool != MeasureTool.Radius && _points.Count > 0)
            {
                <div class="text-muted" style="font-size:12px;">Need @RequiredPoints point(s) — click Pick points or keep clicking the model.</div>
            }
        </div>
    }
</div>

@code {
    private static readonly MeasureTool[] _tools =
    [
        MeasureTool.Distance,
        MeasureTool.PointToPoint,
        MeasureTool.Angle,
        MeasureTool.Radius
    ];

    [Parameter] public bool ModelLoaded { get; set; }
    [Parameter] public EventCallback<(MeasureTool Tool, int PointIndex)> OnPickRequested { get; set; }
    [Parameter] public EventCallback OnPickCancelled { get; set; }

    public MeasureTool ActiveTool { get; private set; } = MeasureTool.None;
    public IReadOnlyList<Point3D> Points => _points;
    public string? LastResult => _result;
    public bool IsPicking => _picking;

    private readonly List<Point3D> _points = [];
    private string? _result;
    private string? _pickWarning;
    private bool _picking;

    private const double MinPickSeparationMm = 0.05;

    public int RequiredPoints => ActiveTool switch
    {
        MeasureTool.Distance or MeasureTool.PointToPoint => 2,
        MeasureTool.Angle => 3,
        _ => 0
    };

    public Point3D?[] GetSnapHits()
    {
        var arr = new Point3D?[3];
        for (var i = 0; i < Math.Min(_points.Count, 3); i++)
            arr[i] = _points[i];
        return arr;
    }

    private static string Label(MeasureTool t) => t switch
    {
        MeasureTool.Distance => "Distance",
        MeasureTool.PointToPoint => "Pt–Pt",
        MeasureTool.Angle => "Angle",
        MeasureTool.Radius => "Radius",
        _ => "—"
    };

    private async Task SelectToolAsync(MeasureTool t)
    {
        await ResetAllAsync();
        ActiveTool = t;
        if (t == MeasureTool.Radius)
            await StartRadiusPickAsync();
    }

    private Task StartPick() => StartPickAsync();

    private async Task StartRadiusPickAsync()
    {
        _picking = true;
        _result = null;
        _pickWarning = null;
        _points.Clear();
        await OnPickRequested.InvokeAsync((MeasureTool.Radius, 0));
        StateHasChanged();
    }

    private async Task StartPickAsync()
    {
        if (ActiveTool is MeasureTool.None or MeasureTool.Radius)
            return;

        _picking = true;
        _result = null;
        await OnPickRequested.InvokeAsync((ActiveTool, _points.Count));
        StateHasChanged();
    }

    public async Task ApplyRadiusAsync(RadiusPickResult pick)
    {
        if (ActiveTool != MeasureTool.Radius)
            return;

        _pickWarning = null;
        _points.Clear();
        _points.Add(pick.Hit);
        _result = $"Radius ({pick.Kind}): {pick.RadiusMm:F3} mm";
        _picking = false;
        await OnPickCancelled.InvokeAsync();
        StateHasChanged();
    }

    public async Task AddPoint(Point3D p)
    {
        if (ActiveTool is MeasureTool.None or MeasureTool.Radius)
            return;

        if (_points.Count > 0 && p.DistanceTo(_points[^1]) < MinPickSeparationMm)
        {
            _pickWarning = "Too close to the previous point — click a different spot on the part.";
            StateHasChanged();
            return;
        }

        _pickWarning = null;
        _points.Add(p);
        _picking = _points.Count < RequiredPoints;

        if (_picking)
        {
            await OnPickRequested.InvokeAsync((ActiveTool, _points.Count));
            StateHasChanged();
            return;
        }

        _result = ComputeResult();
        await OnPickCancelled.InvokeAsync();
        StateHasChanged();
    }

    private string? ComputeResult() => ActiveTool switch
    {
        MeasureTool.Distance or MeasureTool.PointToPoint when _points.Count >= 2 =>
            $"Distance: {MeasureMath.Distance(_points[^2], _points[^1]):F3} mm",
        MeasureTool.Angle when _points.Count >= 3 =>
            MeasureMath.AngleDegrees(_points[0], _points[1], _points[2]) is { } deg
                ? $"Angle: {deg:F2}°"
                : "Angle: points too close (degenerate)",
        _ => null
    };

    private Task OnClearClick() => ResetAllAsync();

    /// <summary>Full reset: points, result, picking flag, warnings, snap mode, and viewport markers.</summary>
    public async Task ResetAllAsync(bool deselectTool = false)
    {
        _points.Clear();
        _result = null;
        _pickWarning = null;
        _picking = false;
        if (deselectTool)
            ActiveTool = MeasureTool.None;
        await OnPickCancelled.InvokeAsync();
        StateHasChanged();
    }
}
