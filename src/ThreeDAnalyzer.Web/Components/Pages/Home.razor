@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OcctService Occt

<PageTitle>3D Part Analyzer</PageTitle>

<div class="analyzer-layout">
    <div class="analyzer-viewport">
        <ModelViewer @ref="_viewer"
                     SnapHint="@_snapHint"
                     SnapPointPicked="OnSnapPointPicked"
                     RadiusPicked="OnRadiusPicked"
                     ErrorOccurred="OnViewerError" />
    </div>

    <aside class="analyzer-sidebar">
        <div class="panel-block">
            <div class="panel-title">Import STEP / STP</div>
            @if (!Occt.IsAvailable)
            {
                <div class="alert alert-warning py-2 px-3 mb-0" style="font-size:12px;">
                    <strong>OCCT not linked.</strong><br />
                    <strong>1.</strong> <code>.\scripts\Import-OcctKit.ps1 -SourcePath "…\opencascade-8.0.0-vc14-64"</code><br />
                    <strong>2.</strong> <code>.\scripts\Build-OcctWrapper.ps1</code> then <code>run.bat</code>
                </div>
            }
            else
            {
                <InputFile OnChange="OnFileSelected"
                           accept=".step,.stp"
                           class="form-control form-control-sm"
                           disabled="@_busy" />
                @if (!string.IsNullOrEmpty(_globalError))
                {
                    <div class="alert alert-danger py-1 px-2 mt-2 mb-0" style="font-size:12px;">@_globalError</div>
                }
            }
        </div>

        <hr class="panel-divider" />

        <VolumeDisplay PartVolumeMm3="Occt.PartVolumeMm3"
                       RawVolumeMm3="_rawVolumeMm3" />

        <hr class="panel-divider" />

        <BoundingBoxPanel @ref="_bboxPanel"
                          BaseBbox="ActiveStockBoundingBox()"
                          OnOffsetsChanged="OnOffsetsChanged" />

        <hr class="panel-divider" />

        <CoordinatePanel @ref="_csPanel"
                         ModelLoaded="Occt.IsLoaded"
                         OnPickRequested="OnCsPickRequested"
                         OnClearRequested="OnCsClearRequested"
                         OnCSApplied="OnCSApplied" />

        <hr class="panel-divider" />

        <MeasurePanel @ref="_measure"
                      ModelLoaded="Occt.IsLoaded"
                      OnPickRequested="OnMeasurePickRequested"
                      OnPickCancelled="OnMeasurePickCancelled" />
    </aside>
</div>

@code {
    private enum SnapTarget { None, Measure, CustomCs }

    private ModelViewer? _viewer;
    private BoundingBoxPanel? _bboxPanel;
    private CoordinatePanel? _csPanel;
    private MeasurePanel? _measure;

    private bool _busy;
    private string? _globalError;
    private string? _snapHint;
    private SnapTarget _snapTarget;

    private double _rawVolumeMm3;
    private BoundingBoxData? _csBbox;
    private CustomCS? _appliedCustomCs;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _globalError = null;
        _rawVolumeMm3 = 0;
        _csBbox = null;
        _appliedCustomCs = null;
        _snapTarget = SnapTarget.None;
        _busy = true;
        StateHasChanged();

        try
        {
            if (_measure is not null)
                await _measure.ResetAllAsync(deselectTool: true);
            if (_viewer is not null)
                await _viewer.LoadModelAsync(e.File);

            RecalcRawVolume();

            if (_viewer != null && Occt.BoundingBox is { } wb)
                await _viewer.RefreshStockBoundingBoxAsync(wb, _bboxPanel?.CurrentOffsets ?? new double[6], null, null);

            if (_viewer != null && _csPanel is not null)
                await _viewer.RefreshPickMarkersAsync(_csPanel.GetSnapHits(), -1);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void OnViewerError(string err)
    {
        _globalError = err;
        StateHasChanged();
    }

    private async Task OnOffsetsChanged(double[] offsets)
    {
        RecalcRawVolume(offsets);

        if (_viewer != null && Occt.BoundingBox is { } wb)
            await _viewer.RefreshStockBoundingBoxAsync(wb, offsets, _appliedCustomCs, _csBbox);
    }

    private void RecalcRawVolume(double[]? offsets = null)
    {
        offsets ??= _bboxPanel?.CurrentOffsets ?? new double[6];
        var bb = ActiveStockBoundingBox();
        if (bb is null) { _rawVolumeMm3 = 0; return; }

        var dx = bb.SizeX + offsets[0] + offsets[1];
        var dy = bb.SizeY + offsets[2] + offsets[3];
        var dz = bb.SizeZ + offsets[4] + offsets[5];
        _rawVolumeMm3 = dx * dy * dz;
    }

    private BoundingBoxData? ActiveStockBoundingBox() => _csBbox ?? Occt.BoundingBox;

    // ── Custom coordinate system ───────────────────────────────────────────

    private async Task OnCsPickRequested(int pointIndex)
    {
        if (_viewer is null || _csPanel is null) return;

        await EndMeasureSnapAsync();

        if (pointIndex < 0)
        {
            _snapTarget = SnapTarget.None;
            _snapHint = null;
            _csPanel.CancelPick();
            await _viewer.ExitSnapModeAsync();
            await _viewer.RefreshPickMarkersAsync(_csPanel.GetSnapHits(), -1);
            return;
        }

        _snapTarget = SnapTarget.CustomCs;
        _snapHint = $"Custom CS — click P{pointIndex + 1} on the model surface";
        await _viewer.RefreshPickMarkersAsync(_csPanel.GetSnapHits(), -1);
        await _viewer.EnterSnapModeAsync(pointIndex);
    }

    private async Task OnCsClearRequested()
    {
        _csBbox = null;
        _appliedCustomCs = null;
        RecalcRawVolume();

        if (_viewer != null && Occt.BoundingBox is { } wb)
            await _viewer.RefreshStockBoundingBoxAsync(wb, _bboxPanel?.CurrentOffsets ?? new double[6], null, null);

        if (_viewer != null)
            await _viewer.ClearSnapMarkersAsync();
    }

    private async Task OnCSApplied(CustomCS cs)
    {
        _busy = true;
        StateHasChanged();
        try
        {
            _csBbox = await Occt.GetBoundingBoxInCustomCSAsync(cs);
            _appliedCustomCs = cs;
            RecalcRawVolume();

            if (_viewer != null && Occt.BoundingBox is { } wb)
                await _viewer.RefreshStockBoundingBoxAsync(wb, _bboxPanel?.CurrentOffsets ?? new double[6], _appliedCustomCs, _csBbox);

            if (_viewer != null && _csPanel is not null)
                await _viewer.RefreshPickMarkersAsync(_csPanel.GetSnapHits(), -1);
        }
        catch (Exception ex)
        {
            _globalError = $"Custom CS error: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ── Measure tools ──────────────────────────────────────────────────────

    private async Task OnMeasurePickRequested((MeasureTool Tool, int PointIndex) args)
    {
        if (_viewer is null || _measure is null) return;

        await EndCsSnapAsync();

        _snapTarget = SnapTarget.Measure;
        _snapHint = args.Tool switch
        {
            MeasureTool.Radius => "Radius — click cylinder, hole, fillet, or circular edge",
            MeasureTool.Angle => $"Angle — click point {args.PointIndex + 1} (2 = vertex)",
            MeasureTool.Distance or MeasureTool.PointToPoint => $"Distance — click point {args.PointIndex + 1}",
            _ => "Click a surface point"
        };

        var pickMode = args.Tool == MeasureTool.Radius ? "radius" : "surface";
        await _viewer.RefreshPickMarkersAsync(_measure.GetSnapHits(), -1);
        await _viewer.EnterSnapModeAsync(args.PointIndex, pickMode);
    }

    private async Task OnMeasurePickCancelled()
    {
        _snapTarget = SnapTarget.None;
        _snapHint = null;
        if (_viewer is null || _measure is null) return;
        await _viewer.ExitSnapModeAsync();
        await _viewer.RefreshPickMarkersAsync(_measure.GetSnapHits(), -1);
    }

    private async Task EndMeasureSnapAsync()
    {
        if (_measure is not null && _snapTarget == SnapTarget.Measure)
            await OnMeasurePickCancelled();
    }

    private async Task EndCsSnapAsync()
    {
        if (_csPanel is not null && _snapTarget == SnapTarget.CustomCs)
            await OnCsPickRequested(-1);
    }

    private async Task OnRadiusPicked(RadiusPickResult pick)
    {
        if (_viewer is null || _measure is null) return;
        if (_snapTarget != SnapTarget.Measure || !_measure.IsPicking)
            return;

        await _measure.ApplyRadiusAsync(pick);
        await _viewer.RefreshPickMarkersAsync(_measure.GetSnapHits(), -1);
        _globalError = null;
        _snapHint = null;
        StateHasChanged();
    }

    private async Task OnSnapPointPicked((int Index, Point3D Hit) args)
    {
        if (_viewer is null) return;

        if (_snapTarget == SnapTarget.CustomCs && _csPanel is not null)
        {
            _csPanel.SetSnapPoint(args.Index, args.Hit);
            await _viewer.ExitSnapModeAsync();
            _snapTarget = SnapTarget.None;
            _snapHint = null;
            await _viewer.RefreshPickMarkersAsync(_csPanel.GetSnapHits(), args.Index);
            return;
        }

        if (_snapTarget == SnapTarget.Measure && _measure is not null && _measure.IsPicking)
        {
            await _measure.AddPoint(args.Hit);
            await _viewer.RefreshPickMarkersAsync(_measure.GetSnapHits(), -1);
            if (!string.IsNullOrEmpty(_measure.LastResult))
                _globalError = null;
            _snapHint = _measure.IsPicking
                ? "Click the next point on the model surface"
                : null;
            StateHasChanged();
        }
    }
}
